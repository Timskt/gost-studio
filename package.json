{
  "name": "gost-studio",
  "private": true,
  "version": "0.1.0",
  "description": "A calm, cross-platform desktop control plane for GOST.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
